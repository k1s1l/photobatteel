// Photo Battle Bot — database schema (PostgreSQL)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum PhotoStatus {
  DRAFT              // uploaded, waiting for the author's confirmation
  PENDING_MODERATION // confirmed, waiting for an admin decision
  ACCEPTED           // accepted into a scheduled battle, waiting for the start
  IN_BATTLE          // posted in a duel and still in the tournament
  ELIMINATED         // lost a duel
  WINNER             // won the whole battle
  REJECTED           // rejected by a moderator
  DELETED            // deleted by the author or an admin
  CANCELLED          // the author cancelled the draft (or it expired)
}

enum PhotoSource {
  PHOTO    // sent as a compressed Telegram photo
  DOCUMENT // sent as an image file
  VIDEO    // sent as a video
}

enum MediaType {
  PHOTO
  VIDEO
}

enum BattleStatus {
  SCHEDULED // accepting entries until startsAt
  RUNNING   // duels are being played
  FINISHED  // winner selected
  CANCELLED
}

enum DuelStatus {
  PENDING  // created, the post is not prepared yet
  READY    // the post was sent to admins, waiting for them to publish it in the channel
  ACTIVE   // published, voting is open until endsAt
  FINISHED // winner decided
}

enum DuelSide {
  A
  B
}

enum AdminRole {
  OWNER // declared in ADMIN_IDS
  ADMIN
}

enum BroadcastStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum PaymentMethod {
  STARS    // Telegram Stars (XTR)
  CARD     // bank card via a Telegram payment provider
  TRANSFER // transfer to the owner's card / Monobank jar, verified by the bank API or an admin
}

enum PaymentStatus {
  PENDING   // invoice / transfer details sent, not paid yet
  CLAIMED   // the buyer says the transfer is done, waiting for verification
  PAID      // votes credited
  REFUNDED  // Stars returned to the buyer
  CANCELLED // transfer expired or rejected
}

enum ActivityAction {
  USER_REGISTERED
  CONSENT_GIVEN
  PHOTO_UPLOADED
  PHOTO_CONFIRMED
  PHOTO_CANCELLED
  PHOTO_APPROVED
  PHOTO_REJECTED
  PHOTO_DELETED
  USER_BLOCKED
  USER_UNBLOCKED
  SETTINGS_UPDATED
  TEMPLATE_UPDATED
  BROADCAST_CREATED
  BROADCAST_FINISHED
  BATTLE_CREATED
  BATTLE_STARTED
  BATTLE_ROUND_STARTED
  BATTLE_FINISHED
  BATTLE_CANCELLED
  DUEL_POST_FAILED
  ADMIN_ACCESS_DENIED
  USER_DATA_DELETED
  PAYMENT_SUCCEEDED
  PAYMENT_REFUNDED
  PAYMENT_CANCELLED
  PAID_VOTES_SPENT
  PACKAGE_UPDATED
  LANGUAGE_CHANGED
}

model User {
  id              Int       @id @default(autoincrement())
  telegramId      BigInt    @unique
  username        String?
  firstName       String
  lastName        String?
  languageCode    String    @default("")
  isBlocked       Boolean   @default(false)
  blockedAt       DateTime?
  blockedReason   String?
  botBlockedAt    DateTime? // user stopped/blocked the bot (detected during broadcasts)
  consentAt       DateTime? // consent to publish entries in the public channel
  photosSubmitted Int       @default(0)
  photosPublished Int       @default(0)
  votesReceived   Int       @default(0)
  voteBalance     Int       @default(0) // purchased votes not spent yet
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastActiveAt    DateTime  @default(now())

  photos         Photo[]
  duelVotes      DuelVote[]
  admin          Admin?
  activities     ActivityLog[]
  moderated      Photo[]     @relation("PhotoModerator")
  battlesCreated Battle[]
  broadcasts     Broadcast[]
  payments       Payment[]
  paidVotes      PaidVote[]

  @@index([votesReceived])
  @@index([username])
}

model Admin {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique
  userId     Int?      @unique
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  role       AdminRole @default(ADMIN)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/** An entry (photo or video) submitted to a battle. */
model Photo {
  id               Int         @id @default(autoincrement())
  userId           Int
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  battleId         Int?
  battle           Battle?     @relation("BattlePhotos", fields: [battleId], references: [id], onDelete: SetNull)
  mediaType        MediaType   @default(PHOTO)
  source           PhotoSource
  fileId           String      // Telegram file_id used for publishing
  fileUniqueId     String
  contentHash      String      // SHA-256 of image bytes (photos) or file_unique_id (videos)
  mimeType         String
  width            Int
  height           Int
  fileSize         Int
  durationSec      Int?        // videos only
  status           PhotoStatus @default(DRAFT)
  votesCount       Int         @default(0) // all votes received in duels (free + paid)
  paidVotes        Int         @default(0) // paid part of votesCount
  previewMessageId Int?
  rejectionReason  String?
  moderatedById    Int?
  moderatedBy      User?       @relation("PhotoModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt      DateTime?
  confirmedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  duelsAsA        Duel[]     @relation("DuelPhotoA")
  duelsAsB        Duel[]     @relation("DuelPhotoB")
  duelsWon        Duel[]     @relation("DuelWinner")
  paidVoteEntries PaidVote[]
  payments        Payment[]
  wonBattle       Battle?    @relation("BattleWinner")

  @@index([userId, status])
  @@index([battleId, status])
  @@index([status, createdAt])
  @@index([contentHash])
  @@index([fileUniqueId])
}

/** A tournament: entries are collected until startsAt, then played in rounds of duels. */
model Battle {
  id              Int          @id @default(autoincrement())
  title           String
  status          BattleStatus @default(SCHEDULED)
  startsAt        DateTime
  roundMinutes    Int          // voting time of every duel
  finalMinutes    Int?         // voting time of the final (null = roundMinutes)
  tiebreakMinutes Int          @default(10)
  currentRound    Int          @default(0)
  /// Admin-chosen end of the current round's voting (null = every pair votes roundMinutes)
  roundEndsAt     DateTime?
  winnerPhotoId   Int?         @unique
  winnerPhoto     Photo?       @relation("BattleWinner", fields: [winnerPhotoId], references: [id], onDelete: SetNull)
  createdById     Int?
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  photos Photo[] @relation("BattlePhotos")
  duels  Duel[]

  @@index([status, startsAt])
}

/** Two entries of one round. photoBId is null for a bye (the entry advances without a vote). */
model Duel {
  id              Int        @id @default(autoincrement())
  battleId        Int
  battle          Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  round           Int
  position        Int
  photoAId        Int
  photoA          Photo      @relation("DuelPhotoA", fields: [photoAId], references: [id], onDelete: Cascade)
  photoBId        Int?
  photoB          Photo?     @relation("DuelPhotoB", fields: [photoBId], references: [id], onDelete: Cascade)
  status          DuelStatus @default(PENDING)
  /// 0 = main vote, 1.. = tiebreak reposts (votes start from zero each stage)
  stage           Int        @default(0)
  votesA          Int        @default(0) // votes of the current stage
  votesB          Int        @default(0)
  /// file_unique_id of the prepared collage; identifies the admin's channel post (photo duels)
  preparedFileUniqueId String?
  /// When the post was sent to admins, and when they were reminded to publish it
  readyAt         DateTime?
  remindedAt      DateTime?
  /// Bot message with the vote buttons, posted as a reply under the admin's channel post
  messageId       Int?
  /// The admin's channel post(s) for this stage (removed if an entry withdraws)
  mediaMessageIds Int[]      @default([])
  postedAt        DateTime?
  endsAt          DateTime?
  winnerPhotoId   Int?
  winnerPhoto     Photo?     @relation("DuelWinner", fields: [winnerPhotoId], references: [id], onDelete: SetNull)
  finishedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  votes     DuelVote[]
  paidVotes PaidVote[]

  @@unique([battleId, round, position])
  @@index([status, endsAt])
}

/** Free vote: one per user per duel stage; the user may switch sides. */
model DuelVote {
  id        Int      @id @default(autoincrement())
  duelId    Int
  duel      Duel     @relation(fields: [duelId], references: [id], onDelete: Cascade)
  stage     Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  side      DuelSide
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([duelId, stage, userId])
  @@index([userId])
}

model BotSettings {
  id                 Int      @id @default(1)
  moderationEnabled  Boolean  @default(false)
  subscribersOnly    Boolean  @default(true) // only channel subscribers may vote
  paidVotesEnabled   Boolean  @default(false)
  maxPhotosPerBattle Int      @default(1)    // 0 = unlimited
  /// Post designs made by an admin in Telegram (HTML, may contain <tg-emoji>); null = default text
  duelTemplate       String?
  announceTemplate   String?
  roundTemplate      String?
  winnerTemplate     String?
  buttonsTemplate    String?
  /// Per-round designs, e.g. {"buttons:final": "<b>ФІНАЛ</b>"}; override the templates above for that round
  stageTemplates     Json     @default("{}")
  /// Payment by transfer to the owner's card / Monobank jar
  transferEnabled    Boolean  @default(false)
  transferDetails    String?  // shown to buyers: card number or jar link
  monobankAccountId  String?  // Monobank account or jar whose statement is checked
  updatedById        Int?
  updatedAt          DateTime @updatedAt
}

model Broadcast {
  id          Int             @id @default(autoincrement())
  createdById Int
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  fromChatId  BigInt
  messageId   Int
  status      BroadcastStatus @default(PENDING)
  lastUserId  Int             @default(0) // resume cursor
  sentCount   Int             @default(0)
  failedCount Int             @default(0)
  createdAt   DateTime        @default(now())
  finishedAt  DateTime?
}

model ActivityLog {
  id         Int            @id @default(autoincrement())
  action     ActivityAction
  userId     Int?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramId BigInt?
  entityType String?
  entityId   String?
  details    Json?
  createdAt  DateTime       @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

/** Packs of votes sold for Stars and/or card. */
model VotePackage {
  id         Int       @id @default(autoincrement())
  votes      Int
  priceStars Int // in Telegram Stars
  priceCard  Int // in minor units of CARD_CURRENCY (kopecks for UAH)
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  payments   Payment[]
}

model Payment {
  id               Int           @id @default(autoincrement())
  userId           Int
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId        Int?
  package          VotePackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  votes            Int
  method           PaymentMethod
  currency         String // XTR for Stars, e.g. UAH for cards
  amount           Int // Stars, or minor currency units
  status           PaymentStatus @default(PENDING)
  /// When set, purchased votes go straight to this entry's current duel instead of the balance.
  targetPhotoId    Int?
  targetPhoto      Photo?        @relation(fields: [targetPhotoId], references: [id], onDelete: SetNull)
  telegramChargeId String?       @unique
  providerChargeId String?
  /// Transfers: code the buyer puts into the payment comment, and the matched bank transaction
  code             String?       @unique
  bankTransactionId String?      @unique
  expiresAt        DateTime?
  claimedAt        DateTime?
  reviewRequestedAt DateTime?    // admins were asked to check it manually
  confirmedById    Int?          // admin who confirmed or rejected it manually
  createdAt        DateTime      @default(now())
  paidAt           DateTime?
  refundedAt       DateTime?

  @@index([status, paidAt])
  @@index([userId, createdAt])
  @@index([method, status])
}

/** Paid votes given to an entry in a specific duel stage. */
model PaidVote {
  id        Int      @id @default(autoincrement())
  photoId   Int
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  duelId    Int
  duel      Duel     @relation(fields: [duelId], references: [id], onDelete: Cascade)
  stage     Int
  side      DuelSide
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  paymentId Int?
  createdAt DateTime @default(now())

  @@index([photoId])
  @@index([duelId, stage])
  @@index([userId, createdAt])
}
