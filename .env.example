# =============================================================
#  Photo Battle Bot — configuration
#  Copy to .env and fill in. NEVER commit the real .env file.
# =============================================================

# --- Telegram (required) -------------------------------------
# Token from @BotFather
BOT_TOKEN=123456789:replace-with-your-token-from-botfather
# Target channel: numeric id (-100XXXXXXXXXX) or @public_username
CHANNEL_ID=-1001234567890
# Admin Telegram user ids, comma separated (get yours from @userinfobot)
ADMIN_IDS=123456789

# Optional: self-hosted Bot API server instead of api.telegram.org
# TELEGRAM_API_ROOT=http://telegram-bot-api:8081

# --- Database & Redis (required) ------------------------------
DATABASE_URL=postgresql://photobattle:change-me@localhost:5432/photobattle?schema=public
REDIS_URL=redis://localhost:6379
# Used only by docker-compose.yml for the bundled PostgreSQL
POSTGRES_PASSWORD=change-me

# --- Runtime ---------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# polling (simplest) or webhook (needs a public HTTPS domain)
BOT_MODE=polling
# WEBHOOK_DOMAIN=https://your-app.up.railway.app
# WEBHOOK_PATH=/telegram/webhook
# Random string, 16-256 chars of A-Z a-z 0-9 _ - (e.g. `openssl rand -hex 32`)
# WEBHOOK_SECRET=
PORT=8080
# all = bot + background workers in one process; bot / worker to split them
APP_ROLE=all
# Timezone for dates in messages and the weekly battle schedule
TIMEZONE=Europe/Kyiv
# uk or ru: channel posts and users whose Telegram language is neither
DEFAULT_LANGUAGE=uk

# --- Paid votes ------------------------------------------------
# Telegram Stars work without any token.
# Card payments: token from @BotFather → your bot → Payments (empty = cards off)
# PAYMENT_PROVIDER_TOKEN=
CARD_CURRENCY=UAH

# --- Photo limits ----------------------------------------------
MAX_PHOTO_SIZE_MB=10
MIN_PHOTO_DIMENSION=320
MAX_PHOTO_DIMENSION=10000

# --- Protection & tournament -----------------------------------
# Max bot actions per user per minute
RATE_LIMIT_PER_MINUTE=30
# Max video length (seconds)
MAX_VIDEO_DURATION_SECONDS=180
# Pause between duel posts (Telegram allows ~20 posts/minute per channel)
DUEL_POST_INTERVAL_SECONDS=5
# Tie: repost the pair for this many minutes (votes start from zero)...
TIEBREAK_MINUTES=10
# ...at most this many times; then the entry sent earlier advances
MAX_TIEBREAKS=3
# Attempts to post a duel on temporary Telegram errors, and the first retry delay
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_RETRY_BASE_MS=30000
# Unconfirmed drafts expire after this many hours
DRAFT_TTL_HOURS=24
# Broadcast speed (Telegram allows ~30 messages/second)
BROADCAST_RATE_PER_SECOND=20
# Verify channel access & bot rights on startup
RUN_STARTUP_CHECKS=true
